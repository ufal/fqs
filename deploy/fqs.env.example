# /etc/fqs/fqs.env — loaded by systemd (EnvironmentFile=).
# Copied from this example by install.sh; edit after install and:
#   sudo systemctl restart fqs

# Required for admin HTTP and TEITOK JWT auth (HS256).
# install.sh generates one if missing; rotate deliberately.
FQS_SECRET=

# Human-readable label in GET /health (and TEITOK probes).
FQS_SERVER_NAME=FQS

# Public FCS / hub URL (optional; used in SRU explain / resource PIDs).
# FQS_FCS_BASE_URL=https://example.org/services/fcs

# Admin UI behind a path-stripping reverse proxy (trailing slash).
# FQS_ADMIN_BASE_HREF=/services/test-kontext/fqsadmin/

# Catalog (defaults to /var/lib/fqs/fqs.db via /etc/fqs/fqs.json).
# FQS_DB_PATH=/var/lib/fqs/fqs.db

# Optional tier limits JSON (see fqs/limits.local.json).
# FQS_LIMITS=/etc/fqs/limits.json

# Only with TEITOK: Python that has `flexicorp` installed (TEITOK shared venv), used for
# reindexing TEITOK projects and for XML fragments of CWB corpora registered with supports_xml.
# Not needed for plain CWB, pando or FCS. (install.sh --teitok-venv sets it.)
# PYTHON_BIN=/var/www/html/teitok/shared/Resources/venv/bin/python

# Pando's warm library (fast in-process queries, all query languages). Without it FQS falls back
# to the cold flexicorp-pando CLI (pando-cql only), and fails pando queries when that is missing too.
# Unset, FQS looks next to its own binary, then /usr/local/lib and /usr/lib; set, only this file
# is tried. install.sh --pando-lib FILE installs it under PREFIX/lib/fqs and sets this line.
# After a pando update, install the new library and restart; check `curl …/health` → pando.mode.
# FLEXICORP_PANDO_LIB=/usr/local/lib/fqs/libflexicorp_pando.so
# FLEXICORP_PANDO_BIN=/usr/local/bin/flexicorp-pando

# Native Manatee (dev/MANATEE-NATIVE.md): libfqs_manatee, built with manatee/build.sh. It runs in
# worker processes FQS starts itself (`fqs manatee-worker`), so a crash in Manatee ends a worker, not
# FQS. Workers: how many Manatee queries run at once. Timeout: a longer query is stopped.
# FQS_MANATEE_LIB=/usr/local/lib/libfqs_manatee.so
# FQS_MANATEE_WORKERS=2
# FQS_MANATEE_TIMEOUT_SECS=300
