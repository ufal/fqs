# /etc/fqs/fqs.env — loaded by systemd (EnvironmentFile=).
# Copied from this example by install.sh; edit after install and:
#   sudo systemctl restart fqs

# Required for admin HTTP and TEITOK JWT auth (HS256).
# install.sh generates one if missing; rotate deliberately.
FQS_SECRET=

# Human-readable label in GET /health (and TEITOK probes).
FQS_SERVER_NAME=FQS

# Public FCS / hub URL (optional; used in SRU explain / resource PIDs).
# FQS_FCS_BASE_URL=https://example.org/services/fcs

# Admin UI behind a path-stripping reverse proxy (trailing slash).
# FQS_ADMIN_BASE_HREF=/services/test-kontext/fqsadmin/

# Catalog (defaults to /var/lib/fqs/fqs.db via /etc/fqs/fqs.json).
# FQS_DB_PATH=/var/lib/fqs/fqs.db

# Optional tier limits JSON (see fqs/limits.local.json).
# FQS_LIMITS=/etc/fqs/limits.json

# Python that has `flexicorp` installed (TEITOK shared venv).
# Without this, reindex uses system python3 and fails with:
#   No module named flexicorp
PYTHON_BIN=/var/www/html/teitok/shared/Resources/venv/bin/python

# Optional: native Pando library for hot query path.
# FLEXICORP_PANDO_LIB=/usr/local/lib/libflexicorp_pando.so
# FLEXICORP_PANDO_BIN=/usr/local/bin/flexicorp-pando
